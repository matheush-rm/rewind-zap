# Número de quem PERDEU as conversas (B), com DDI e DDD, só dígitos
PARTNER=5511999998888

# Pausa entre mensagens (ms). Menor = mais rápido, mas mais risco de bloqueio por spam.
DELAY_MS=500
# Quanto tempo A espera antes de apagar "para mim" a cópia nova (roda em paralelo, não atrasa o envio)
DELETE_DELAY_MS=5000
# Segundos sem novos blocos de histórico até o export encerrar a sincronização
HISTORY_IDLE_S=300
# Downloads de mídia simultâneos no export
MEDIA_CONCURRENCY=3

# Para o replay após N erros seguidos e mostra o erro (circuit breaker)
BREAKER_LIMIT=10

# NO_DELETE=1            # não apaga as cópias em A (ex: A vai restaurar um backup no fim)

# SKIP_MISSING_MEDIA=1   # pula mensagens cuja mídia não pôde ser baixada
# FORCE_CONTINUE=1       # segue mesmo sem confirmar recebimento (use só após conferir no celular)
# LOG_LEVEL=warn
